project('maha', ['vala', 'c'],
  version: '0.1.0',
  license: 'MIT',
  meson_version: '>= 0.56.0',
  default_options: ['warning_level=2', 'optimization=2'])

gnome = import('gnome')

glib_dep = dependency('glib-2.0')
gio_dep = dependency('gio-2.0')
gtk_dep = dependency('gtk4')
adw_dep = dependency('libadwaita-1', version: '>= 1.0')

# All C here is generated by valac; silence its well-known false positives.
# Applied at target level so it also overrides the -Wall/-Wextra set by
# warning_level, which would otherwise re-enable some of these.
maha_c_args = [
  '-Wno-unused-parameter',
  '-Wno-cast-function-type',
  '-Wno-discarded-qualifiers',
  '-Wno-unused-but-set-variable',
  '-Wno-unused-variable',
  '-Wno-unused-function',
]

subdir('data')
subdir('src')
subdir('tests')
